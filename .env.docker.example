# Docker Compose secrets for the prod stack.
# Copy to .env.docker (gitignored) and fill in real values before `docker compose up`.
# Referenced by the `requesthole-postgres` and `backend` services via env_file.

# Postgres credentials — consumed by the postgres image to initialize the DB.
POSTGRES_USER=requesthole
POSTGRES_PASSWORD=change-me
POSTGRES_DB=requesthole

# Connection string the backend reads as process.env.POSTGRES_URI.
# Host must be the compose service name `requesthole-postgres`; port 5432 is internal.
# Keep user/password/db in sync with the three values above.
POSTGRES_URI=postgres://requesthole:change-me@requesthole-postgres:5432/requesthole
